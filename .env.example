# Local development only. Copy to .env (ignored); never commit actual credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
MONGODB_URI=mongodb://127.0.0.1:27017/pass_the_movie?replicaSet=rs0&directConnection=true

# S3Mock local test configuration. Use dummy credentials, never real cloud secrets.
R2_ENDPOINT=http://127.0.0.1:9000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ptm-local
SESSION_TOKEN_PEPPER=

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Reference defaults. The current development quotas are fixed in shared/server code.
# These reference values are not configurable runtime overrides.
WORKER_CONCURRENCY=1
MAX_UPLOAD_BYTES=12582912
MAX_ACTIVE_MOVIES=100
MAX_DAILY_UPLOAD_BYTES=524288000
MEDIA_PROCESSING_TIMEOUT_MS=90000
PUBLIC_LAUNCH_ENABLED=false
# Restart local API after changing this. Existing movie access and cleanup remain available.
NEW_MOVIES_PAUSED=false
# Enable only on localhost with the disposable local services.
SINGLE_SCENE_DEV_ENABLED=false
# Future client variable: set only in apps/web/.env.local when API calls are implemented.
# NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
