# Local development only. Copy to .env (ignored); never commit actual credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
MONGODB_URI=mongodb://127.0.0.1:27017/pass_the_movie?replicaSet=rs0&directConnection=true

# Future storage integration. Local-only MinIO credentials must be chosen by developer.
R2_ENDPOINT=http://127.0.0.1:9000
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ptm-local
SESSION_TOKEN_PEPPER=

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Reserved processing and abuse limits; not yet enforced by the health-only scaffold.
WORKER_CONCURRENCY=1
MAX_UPLOAD_BYTES=12582912
MAX_ACTIVE_MOVIES=100
MAX_DAILY_UPLOAD_BYTES=524288000
MEDIA_PROCESSING_TIMEOUT_MS=90000
PUBLIC_LAUNCH_ENABLED=false
# Future client variable: set only in apps/web/.env.local when API calls are implemented.
# NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
